{
  "_about": {
    "what": "Trimmed copy of a REAL stage-S7 payload (Boltz-2 2.2.1 on CPU with msa_mode 'empty', so no sequence left the machine; DiscoTope-3.0 on the Boltz models), for designing the structure screen.",
    "how_made": "On 2026-11-15 I re-ran S7 with the code on main (d3b5f5b) over a copy of my real 2026-11-14 run folder. The Boltz-2 models came from the content cache and are identical to the 2026-11-14 folds (same model sha256). Run in a plain run folder, so the outer envelope of the file was stream B's own; on main a RunStore run wraps this same payload in stream A's envelope (digest, producer, inputs as a dict).",
    "inputs": "a sample of the real N. meningitidis MC58 proteome (UniProt), not the 40-protein fixture. None of the three folded proteins is a Bexsero antigen.",
    "run_settings": {
      "s7.top_k": 3,
      "s7.boltz": {
        "msa": "empty",
        "accelerator": "cpu",
        "recycling_steps": 1,
        "sampling_steps": 50,
        "max_residues": 400
      },
      "refdata.offline": true,
      "note": "recycling_steps 1 / sampling_steps 50 are fast smoke settings, not the defaults (3 / 200); pLDDT may be lower than a default run would give. These settings are not recorded inside analysis.folding."
    },
    "validators": "esmfold and af2-no-msa were unavailable on this machine, so validator_agreement.value is null (n_validators 0).",
    "removed_to_keep_it_small": [
      "per-candidate: sequence, tcell, bcell, coverage, upstream",
      "payload: epitope_set, set_level_coverage, upstream",
      "candidates other than the 3 folded ones and 2 of the not_selected ones"
    ],
    "not_in_the_artifact": "per-residue pLDDT. Only mean_plddt, the frac_* bands and n_residues_modelled are stored; the per-residue values are in the B-factor column of the PDB that structure.model_file points to (a run-folder file reference with sha256 and bytes; the PDB files are not committed).",
    "not_validation": "Confidence of a structural model says nothing about immunogenicity or protection (see payload.limits)."
  },
